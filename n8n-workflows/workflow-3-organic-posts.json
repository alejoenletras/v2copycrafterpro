      "parameters": {
        "jsCode": "// Guardar run_id y preparar items de competidores\nconst runResult = $input.first().json;\nconst competitors = $('Get Found Competitors').first().json;\nconst runId = Array.isArray(runResult) ? runResult[0]?.id : runResult?.id;\nconst comps = Array.isArray(competitors) ? competitors : [competitors];\n\nreturn comps.filter(c => c && !c._empty).map(c => ({\n  json: { ...c, run_id: runId }\n}));"
      },
