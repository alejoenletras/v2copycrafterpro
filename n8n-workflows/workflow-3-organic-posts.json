    {
      "parameters": {
        "jsCode": "// Filtrar posts de IG por views/likes y normalizar\nconst posts = $input.first().json;\nconst competitor = $('IF: Has IG').first().json;\nconst items = Array.isArray(posts) ? posts : [posts];\n\nconst filtered = items.filter(p => {\n  if (!p || p._empty) return false;\n  const isVideo = p.type === 'Video' || p.videoUrl;\n  if (isVideo) return (p.videoViewCount || p.videoPlayCount || 0) >= 50000;\n  return (p.likesCount || 0) >= 5000;\n}).map(p => {\n  const isVideo = p.type === 'Video' || p.videoUrl;\n  const isCarousel = p.type === 'Sidecar' || (p.images && p.images.length > 1);\n  return {\n    competitor_id: competitor.id,\n    platform: 'instagram',\n    post_type: isVideo ? 'video' : (isCarousel ? 'carousel' : 'image'),\n    post_url: p.url || p.shortCode ? `https://www.instagram.com/p/${p.shortCode}/` : null,\n    post_id: p.id || p.shortCode || '',\n    posted_at: p.timestamp || null,\n    views: p.videoViewCount || p.videoPlayCount || 0,\n    likes: p.likesCount || 0,\n    comments: p.commentsCount || 0,\n    shares: 0,\n    caption: p.caption || '',\n    media_url: p.videoUrl || p.displayUrl || (p.images && p.images[0]) || null,\n    thumbnail_url: p.displayUrl || null,\n    run_id: competitor.run_id\n  };\n});\n\nreturn filtered.length > 0 \n  ? filtered.map(p => ({ json: p }))\n  : [{ json: { _empty: true, run_id: competitor.run_id, competitor_id: competitor.id } }];"
      },
