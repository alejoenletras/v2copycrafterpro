    {
      "parameters": {
        "jsCode": "// Filtrar posts de TikTok por views >= 50000\nconst posts = $input.first().json;\nconst competitor = $('IF: Has TikTok').first().json;\nconst items = Array.isArray(posts) ? posts : [posts];\n\nconst filtered = items.filter(p => {\n  if (!p || p._empty) return false;\n  return (p.playCount || p.stats?.playCount || 0) >= 50000;\n}).map(p => ({\n  competitor_id: competitor.id,\n  platform: 'tiktok',\n  post_type: 'video',\n  post_url: p.webVideoUrl || `https://www.tiktok.com/@${competitor.tiktok_handle}/video/${p.id}`,\n  post_id: p.id || '',\n  posted_at: p.createTimeISO || (p.createTime ? new Date(p.createTime * 1000).toISOString() : null),\n  views: p.playCount || p.stats?.playCount || 0,\n  likes: p.diggCount || p.stats?.diggCount || 0,\n  comments: p.commentCount || p.stats?.commentCount || 0,\n  shares: p.shareCount || p.stats?.shareCount || 0,\n  caption: p.text || p.desc || '',\n  media_url: p.videoUrl || null,\n  thumbnail_url: p.covers?.default || p.video?.cover || null,\n  run_id: competitor.run_id\n}));\n\nreturn filtered.length > 0\n  ? filtered.map(p => ({ json: p }))\n  : [{ json: { _empty: true, run_id: competitor.run_id, competitor_id: competitor.id } }];"
      },
