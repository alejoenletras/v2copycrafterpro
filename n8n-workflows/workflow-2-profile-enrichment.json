      "id": "b2000001-0001-0001-0001-000000000023",
      "name": "Get TikTok Results",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1540, 460]
    },
    {
      "parameters": {
        "jsCode": "// Preparar datos para validación con Haiku\nconst results = $input.first().json;\nconst competitor = $('IF: TikTok Pending').first().json;\nconst profiles = Array.isArray(results) ? results : [results];\n\nif (!profiles.length || profiles[0]._empty) {\n  return [{ json: { competitor_id: competitor.id, tiktok_found: false, match: false } }];\n}\n\n// Tomar el primer perfil encontrado\nconst profile = profiles[0];\nconst handle = profile.uniqueId || profile.author?.uniqueId || profile.username || '';\nconst nickname = profile.nickname || profile.author?.nickname || '';\n\nreturn [{\n  json: {\n    competitor_id: competitor.id,\n    fb_page_name: competitor.fb_page_name,\n    tiktok_handle: handle,\n    tiktok_nickname: nickname,\n    tiktok_profile_url: handle ? `https://www.tiktok.com/@${handle}` : '',\n    has_result: !!handle\n  }\n}];"
      },
      "id": "b2000001-0001-0001-0001-000000000024",
      "name": "Prepare TikTok Validation",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1760, 460]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "" },
          "conditions": [
            {
              "leftValue": "={{ $json.has_result }}",
              "rightValue": "true",
              "operator": { "type": "boolean", "operation": "true" }
            }
          ]
        }
      },
      "id": "b2000001-0001-0001-0001-000000000025",
      "name": "IF: TikTok Has Result",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1980, 460]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-api-key", "value": "={{ $env.ANTHROPIC_API_KEY }}" },
            { "name": "anthropic-version", "value": "2023-06-01" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-haiku-4-5-20251001\",\n  \"max_tokens\": 10,\n  \"messages\": [{\n    \"role\": \"user\",\n    \"content\": \"¿Este perfil de TikTok corresponde a esta marca de Facebook? Responde SOLO 'yes' o 'no'.\\n\\nMarca Facebook: {{ $json.fb_page_name }}\\nPerfil TikTok: @{{ $json.tiktok_handle }} ({{ $json.tiktok_nickname }})\"\n  }]\n}",
        "options": { "timeout": 30000 }
      },
      "id": "b2000001-0001-0001-0001-000000000026",
      "name": "Haiku: Validate Match",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2200, 360]
    },
    {
      "parameters": {
        "jsCode": "// Parsear respuesta de Haiku\nconst response = $input.first().json;\nconst prev = $('IF: TikTok Has Result').first().json;\nconst text = response.content?.[0]?.text?.toLowerCase().trim() || '';\nconst isMatch = text.includes('yes');\n\nreturn [{\n  json: {\n    competitor_id: prev.competitor_id,\n    match: isMatch,\n    tiktok_handle: prev.tiktok_handle,\n    tiktok_profile_url: prev.tiktok_profile_url\n  }\n}];"
      },
