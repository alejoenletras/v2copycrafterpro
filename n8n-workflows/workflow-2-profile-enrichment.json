      "id": "b2000001-0001-0001-0001-000000000013",
      "name": "Get FB Page Data",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1540, 60]
    },
    {
      "parameters": {
        "jsCode": "// Extraer Instagram handle de los datos de la página de Facebook\nconst pageData = $input.first().json;\nconst competitor = $('IF: IG Pending').first().json;\nlet igHandle = null;\nlet igUrl = null;\n\n// Buscar en diferentes formatos de respuesta de Apify\nconst items = Array.isArray(pageData) ? pageData : [pageData];\nfor (const item of items) {\n  // Buscar en social links\n  const socialLinks = item.socialLinks || item.social_links || {};\n  if (socialLinks.instagram) {\n    igUrl = socialLinks.instagram;\n    const match = igUrl.match(/instagram\\.com\\/([^/?]+)/);\n    if (match) igHandle = match[1];\n  }\n  // Buscar en connected_instagram\n  if (!igHandle && item.connected_instagram) {\n    igHandle = item.connected_instagram.replace('@', '');\n    igUrl = `https://www.instagram.com/${igHandle}`;\n  }\n  // Buscar en about / info\n  if (!igHandle && item.about) {\n    const igMatch = item.about.match(/instagram\\.com\\/([a-zA-Z0-9_.]+)/);\n    if (igMatch) {\n      igHandle = igMatch[1];\n      igUrl = `https://www.instagram.com/${igHandle}`;\n    }\n  }\n}\n\nreturn [{\n  json: {\n    competitor_id: competitor.id,\n    ig_found: !!igHandle,\n    ig_handle: igHandle,\n    ig_profile_url: igUrl\n  }\n}];"
      },
